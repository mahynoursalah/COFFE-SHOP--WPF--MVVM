<UserControl
    x:Class="WpfApp1.CustomerView.CustomerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WpfApp1.CustomerView"
    xmlns:local1="clr-namespace:WpfApp1.Converters"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local1:NavigationEnumToValueConverter x:Key="NavigationEnumToValueConverter" />
        <DataTemplate x:Key="CustomerDataTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding FirstName}" Margin="0,0,5,0" FontWeight="Bold"/>
                <TextBlock Text="{Binding LastName}" FontWeight="Bold"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  x:Name="CustomersList" instead of old method to navigate button use binding on property navigation coulmn  -->
        <Grid Grid.Column="{Binding NavigationSide, Converter={StaticResource NavigationEnumToValueConverter}}" Background="{StaticResource CustomerListView}" Width="260">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Button
                    Width="75"
                    Margin="10"
                    Command="{Binding addcommand}"
                    Content="+ Add" />
                <Button
                    Width="75" Command="{Binding deletecommand}"
                    Margin="0,10,10,10"
                    Content="Delete" />
                <Button Margin="0,10,10,10" Command="{Binding movenavigation}">
                    <Image
                        Width="20"
                        Height="20"
                        Source="/Images/20.PNG" />
                </Button>
            </StackPanel>
            <!--  x:Name="customerListView"  -->
            <ListView
                Grid.Row="1"
                Margin="10,0,10,10"
                ItemsSource="{Binding Customers}"
                SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}" 
                ItemTemplate="{StaticResource CustomerDataTemplate}">
               
            </ListView>
            <!--  ItemsSource="{Binding Customers}" DisplayMemberPath="FirstName"  -->

            <!--  روح عالفيو موديل هتلاقي هناك في كاستمرز و هاتها و من الكاستمرز عايزه من الموديل الفيرست نيم  -->




        </Grid>
        <!--  بدل ما كنت بعمل بايندينج علي list view لا انا هعمل علي selectedcustomer من فيو موديل علي طول  -->


        <!--  Customer details  -->
        <StackPanel Grid.Column="1" Margin="10" Visibility="{Binding IsCustomerSelected  , Converter={StaticResource BooleanToVisibilityConv}}">
            <Label Content="First Name" />
            <!--<TextBox Text="{Binding ElementName=customerListView , Path=SelectedItem.FirstName , Mode=TwoWay , UpdateSourceTrigger=PropertyChanged}"/>-->
            <TextBox Text="{Binding SelectedCustomer.FirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Label Content="Last Name" />
            <TextBox Text="{Binding SelectedCustomer.LastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <CheckBox Margin="0,10,0,0" Content="Is developer" />
        </StackPanel>
    </Grid>
</UserControl>
